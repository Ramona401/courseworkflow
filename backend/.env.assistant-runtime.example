# TE-DNA课件原生教学智能体运行专用配置示例
#
# 生产环境实际文件：
# /www/wwwroot/tedna/private/config/assistant-runtime.env
#
# systemd在backend/.env之后加载本文件。
#
# 本专用文件只允许声明以下四个变量：
#   - COURSEWARE_ASSISTANT_ENABLED
#   - COURSEWARE_ASSISTANT_PUBLIC_RUNTIME_ENABLED
#   - ASSISTANT_RUNTIME_PRIVACY_SALT
#   - ASSISTANT_RUNTIME_TOKEN_TTL_MINUTES
#
# 禁止在本文件中声明或覆盖：
#   - 数据库连接配置；
#   - JWT_SECRET；
#   - AES_KEY；
#   - AI API地址、密钥或模型；
#   - 其他平台业务配置。

# ==================== 教师端功能总开关 ====================
#
# true：
#   - 开放课件教学智能体插槽；
#   - 开放教学方案生成；
#   - 开放部署管理；
#   - 开放教师内部预览。
#
# false：
#   - 教师端教学智能体保留路径统一返回404；
#   - 不影响课件工坊、漫画、Style Studio和其他现有功能；
#   - 配置加载层会强制把公开运行开关收敛为false。
#
# 开发单元27目标状态保持true。
COURSEWARE_ASSISTANT_ENABLED=true

# ==================== 公开学生运行总开关 ====================
#
# true：
#   - 开放官方embed页面；
#   - 允许创建external匿名学生会话；
#   - 允许已签发external令牌读取会话和聊天。
#
# false：
#   - embed页面返回503；
#   - external新会话创建返回503；
#   - 已签发external令牌在服务层按session_kind即时拒绝；
#   - teacher_preview教师内部预览继续正常运行。
#
# 开发单元27目标状态必须保持false。
# 只有单元26真实业务验收通过并进入单域名试点后才能改为true。
COURSEWARE_ASSISTANT_PUBLIC_RUNTIME_ENABLED=false

# ==================== 匿名运行隐私盐 ====================
#
# 生产生成命令：
# openssl rand -hex 32
#
# 结果必须为64个十六进制字符。
#
# 该盐只用于：
#   - 匿名客户端标识HMAC；
#   - 客户端IP HMAC；
#   - 教师预览身份用途隔离HMAC。
#
# 不得复用JWT、AES、数据库、AI密钥或其他业务盐值。
ASSISTANT_RUNTIME_PRIVACY_SALT=替换为openssl生成的64字符独立随机十六进制字符串

# ==================== 短时运行令牌有效期 ====================
#
# 后端合法范围为5至15分钟。
# 非法值会确定性回退为15分钟。
ASSISTANT_RUNTIME_TOKEN_TTL_MINUTES=15
